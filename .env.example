# Local/reference deployment defaults. Do not commit real credentials.
# External binding remains intentionally unsupported until the production
# Security/Policy/Approval baseline is complete.
SCORESYMPHONY_BIND_HOST=127.0.0.1

SCORESYMPHONY_FORGE_PORT=8080
SCORESYMPHONY_FORGE_LOG_LEVEL=info
SCORESYMPHONY_FORGE_TIMEOUT_SECONDS=10
SCORESYMPHONY_EVENT_PAGE_LIMIT=100
SCORESYMPHONY_FORGE_CPUS=2.0
SCORESYMPHONY_FORGE_MEMORY=2g

SCORESYMPHONY_GATEWAY_PORT=8090
SCORESYMPHONY_GATEWAY_CPUS=1.0
SCORESYMPHONY_GATEWAY_MEMORY=512m

# Required by the reference profile after Forge auth bootstrap.
# Create a Forge personal access token through the local Forge auth API and
# replace this placeholder locally. Never commit the resulting token.
FORGE_BEARER_TOKEN=replace-with-local-forge-token

# Credential used by Hermes/operators when calling the ScoreSymphony Gateway.
# Generate a high-entropy local value and replace this placeholder locally.
SCORESYMPHONY_GATEWAY_BEARER_TOKEN=replace-with-local-gateway-token

SCORESYMPHONY_LOG_MAX_SIZE=10m
SCORESYMPHONY_LOG_MAX_FILES=3

# Upstream smoke profile only.
HERMES_UID=10000
HERMES_GID=10000
SCORESYMPHONY_HERMES_CPUS=2.0
SCORESYMPHONY_HERMES_MEMORY=2g
