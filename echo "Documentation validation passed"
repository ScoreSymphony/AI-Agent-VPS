#!/usr/bin/env python3
"""
License compliance checker for ScoreSymphony Agent Platform
"""

import os
import yaml
from pathlib import Path

def check_upstream_licenses():
    """Check that upstream components have proper licenses"""
    print("Checking upstream licenses...")
    
    # Load upstream configuration
    with open('UPSTREAMS.yaml', 'r') as f:
        upstreams = yaml.safe_load(f)
    
    for name, config in upstreams['upstreams'].items():
        license_type = config.get('license', 'unknown')
        print(f"Upstream '{name}': {license_type}")
        
        # Check for MIT license (required for core components)
        if license_type != 'MIT':
            print(f"  WARNING: {name} uses {license_type}, not MIT")
            
    print("Upstream license check complete")

def check_component_licenses():
    """Check that components have proper licenses"""
    print("Checking component licenses...")
    
    # Load component configuration
    with open('COMPONENTS.yaml', 'r') as f:
        components = yaml.safe_load(f)
    
    for name, config in components['components'].items():
        license_type = config.get('license', 'unknown')
        bundled = config.get('bundled', False)
        print(f"Component '{name}': {license_type} (bundled: {bundled})")
        
        # Check for MIT license for bundled components
        if bundled and license_type != 'MIT':
            print(f"  ERROR: Bundled component {name} uses {license_type}, not MIT")
            
    print("Component license check complete")

def main():
    """Main function to run all license checks"""
    print("Running license compliance checks...")
    
    try:
        check_upstream_licenses()
        check_component_licenses()
        print("All license checks completed successfully")
    except Exception as e:
        print(f"License check failed: {e}")
        return 1
        
    return 0

if __name__ == "__main__":
    exit(main())
