{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoresymphony.dev/contracts/v1/command.schema.json",
  "title": "ScoreSymphony platform command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "command", "actor", "task_id", "execution_id", "correlation_id", "issued_at", "idempotency", "payload"],
  "properties": {
    "schema_version": {"const": 1},
    "command_id": {"type": "string", "format": "uuid"},
    "command": {"enum": ["create_task", "update_task", "start_task", "submit_task", "request_changes_task", "approve_task", "cancel_task", "retry_execution", "cancel_execution"]},
    "actor": {"$ref": "#/$defs/actor"},
    "task_id": {"oneOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "execution_id": {"oneOf": [{"type": "string", "format": "uuid"}, {"type": "null"}]},
    "correlation_id": {"type": "string", "format": "uuid"},
    "issued_at": {"type": "string", "format": "date-time"},
    "idempotency": {"$ref": "#/$defs/idempotency"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"command": {"const": "create_task"}}}, "then": {"properties": {"task_id": {"type": "null"}, "execution_id": {"type": "null"}, "payload": {"$ref": "#/$defs/create_task_payload"}}}},
    {"if": {"properties": {"command": {"enum": ["update_task", "start_task", "submit_task", "request_changes_task", "approve_task", "cancel_task"]}}}, "then": {"properties": {"task_id": {"type": "string", "format": "uuid"}, "execution_id": {"type": "null"}}}},
    {"if": {"properties": {"command": {"const": "update_task"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/update_task_payload"}}}},
    {"if": {"properties": {"command": {"enum": ["start_task", "submit_task", "approve_task", "cancel_task"]}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/task_action_payload"}}}},
    {"if": {"properties": {"command": {"const": "request_changes_task"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/request_changes_payload"}}}},
    {"if": {"properties": {"command": {"enum": ["retry_execution", "cancel_execution"]}}}, "then": {"properties": {"task_id": {"type": "string", "format": "uuid"}, "execution_id": {"type": "string", "format": "uuid"}, "payload": {"$ref": "#/$defs/empty_payload"}}}}
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {"type": {"enum": ["user", "hermes", "system"]}, "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "scope", "replay_policy"],
      "properties": {"key": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}, "scope": {"const": "command"}, "replay_policy": {"const": "return_previous"}}
    },
    "create_task_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "title"],
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"oneOf": [{"type": "string", "maxLength": 20000}, {"type": "null"}]}
      }
    },
    "update_task_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "description": {"oneOf": [{"type": "string", "maxLength": 20000}, {"type": "null"}]},
        "priority": {"type": "integer"}
      },
      "anyOf": [{"required": ["title"]}, {"required": ["description"]}, {"required": ["priority"]}]
    },
    "task_action_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "request_changes_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "reason"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "empty_payload": {"type": "object", "additionalProperties": false}
  }
}
